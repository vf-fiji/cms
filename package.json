{
  "name": "reef-cms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reef CMS: a visual, developer-friendly content management system.",
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared --watch-preserve-output --import tsx server/index.ts",
    "start": "cross-env NODE_ENV=production node --import tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-reporter=spec \"tests/**/*.suite.ts\"",
    "theme:vodafone": "node --import tsx scripts/apply-vodafone-theme.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "restore": "node --import tsx scripts/restore.ts",
    "media:variants": "node --import tsx -e \"import('./server/images.ts').then((m) => m.backfillVariants(true))\""
  },
  "dependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@types/sanitize-html": "2.16.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "image-size": "^2.0.4",
    "liquidjs": "^10.30.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "2.18.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.59.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
