# Copy to .env (never commit .env). compose.yaml reads it automatically.

# Public https:// address of the site. Required in production for password reset links.
REEF_PUBLIC_URL=https://cms.example.com

# First administrator, used only when the database is created. Otherwise VodaForge writes
# random credentials to data/admin-credentials.txt.
# REEF_ADMIN_EMAIL=you@example.com
# REEF_ADMIN_PASSWORD=change-me-to-something-long

# Which proxies to believe for X-Forwarded-For / X-Forwarded-Proto.
# Default outside Docker: loopback. compose.yaml defaults to "loopback, uniquelocal".
# REEF_TRUST_PROXY=loopback

# Outgoing email (password resets, form notifications). Without SMTP_HOST, production sends nothing and
# development prints emails to the console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# true for port 465 (implicit TLS); port 587 upgrades with STARTTLS
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=secret
# SMTP_FROM="VodaForge <no-reply@example.com>"

# Reset links stay valid this many minutes (default 60).
# REEF_RESET_TTL_MINUTES=60

# Rate limits per client IP (0 turns a limit off).
# Public form submissions per minute:
# REEF_RATE_LIMIT_FORMS=10
# /api/fn/* requests per minute:
# REEF_RATE_LIMIT_FN=120
# "Forgot password" requests per 15 minutes:
# REEF_RATE_LIMIT_RESET=5

# Backups (npm run backup)
# REEF_BACKUP_DIR=./backups
# REEF_BACKUP_KEEP=14

# Host port for compose.yaml (bound to 127.0.0.1 only)
# REEF_HOST_PORT=4400

# Built-in daily backups (server time; comma-separate several) and an off-site copy command.
# The new backup folder is passed in $REEF_BACKUP_PATH.
# REEF_BACKUP_AT=03:15
# REEF_BACKUP_AFTER='rclone copy "$REEF_BACKUP_PATH" offsite:reef/"$REEF_BACKUP_NAME"'

# Errors, crashes and failed backups are POSTed here (Slack/Teams/Discord/custom webhook).
# REEF_ALERT_WEBHOOK=https://hooks.slack.com/services/...
# Days to keep data/logs/errors-*.jsonl (default 14)
# REEF_LOG_KEEP_DAYS=14

# Server function workers: pool size, memory per worker (MB), time limit per call (ms)
# REEF_FN_WORKERS=4
# REEF_FN_MEMORY_MB=256
# REEF_FN_TIMEOUT_MS=10000

# Longest a cached public page is reused (edits always show immediately). 0 turns the cache off.
# REEF_PAGE_CACHE_SECONDS=300

# Extra import-map entries for React widgets, as JSON (merged with Settings › Import map).
# REEF_IMPORT_MAP={"@fnrl/kit":"https://fnrl.example.com/cms-kit/fnrl-kit.js"}
